# Local environments and runtime files
.venv/
__pycache__/
.pytest_cache/
.DS_Store
outputs/
*.egg-info/

# Videos, extracted frames, caches, model weights and runtime ownership files
.cache/
tests/fixtures/*.mp4
.battle-artifact-owners.json

# Reports are generated by default; retain documentation and curated inputs.
/reports/**
!/reports/**/
!/reports/**/*.md
!/reports/battles/*/inputs/*.json

# Explicit small validation summaries (not full states or event/OCR dumps).
